# Copie este arquivo para .env.local e preencha. NUNCA coloque valores reais aqui.

# Supabase (painel do projeto > Settings > API). Estas duas são públicas por desenho.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Pluggy (dashboard.pluggy.ai). SEGREDOS: só no servidor, nunca com prefixo NEXT_PUBLIC_.
# Na Vercel, cadastre em Settings > Environment Variables. Nunca cole no chat.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
